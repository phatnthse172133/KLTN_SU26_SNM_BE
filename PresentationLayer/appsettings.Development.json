{
  "DataProtection": {
    "KeysPath": ".data-protection-keys"
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "PayOS": {
    "ReturnUrl": "snmcustomer://payment/success",
    "CancelUrl": "snmcustomer://payment/cancel",
    "WebhookUrl": ""
  },
  "SeedData": {
    "FoodTaxonomy": true
  },
  "Assistant": {
    "CandidateBatchSize": 8,
    "SemanticBatchMaxConcurrency": 4,
    "CompactCandidateProjection": {
      "IncludeDescription": true,
      "IncludeIngredients": true,
      "IncludeAllergens": true,
      "IncludeDietary": true,
      "IncludeTastes": true,
      "IncludePreparation": true,
      "IncludeCourses": true,
      "MaxDescriptionCharacters": 200
    }
  },
  "OpenAI": {
    "MaxInputCharacters": 32000
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:3001",
      "http://127.0.0.1:3001",
      "http://localhost:8081",
      "http://127.0.0.1:8081",
      "http://localhost:8082",
      "http://127.0.0.1:8082",
      "http://localhost:8083",
      "http://127.0.0.1:8083",
      "http://localhost:8084",
      "http://127.0.0.1:8084",
      "http://localhost:19006",
      "http://127.0.0.1:19006"
    ],
    "AllowCredentials": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Model.Validation": "Error",
      "LuckyPennySoftware.AutoMapper.License": "Error"
    }
  }
}
