{
  "DataProtection": {
    "KeysPath": ".data-protection-keys"
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "DevelopmentDatabaseName": "SmartNightMarket_Local"
  },
  "BackgroundWorkers": {
    "Enabled": false
  },
  "PayOS": {
    "ReturnUrl": "snmcustomer://payment/success",
    "CancelUrl": "snmcustomer://payment/cancel",
    "WebhookUrl": ""
  },
  "SeedData": {
    "FoodTaxonomy": false,
    "PackageImages": false,
    "PackagePolicies": false
  },
  "Assistant": {
    "CandidateBatchSize": 8,
    "SemanticBatchMaxConcurrency": 4,
    "CompactCandidateProjection": {
      "IncludeDescription": true,
      "IncludeIngredients": true,
      "IncludeAllergens": true,
      "IncludeDietary": true,
      "IncludeTastes": true,
      "IncludePreparation": true,
      "IncludeCourses": true,
      "MaxDescriptionCharacters": 200
    }
  },
  "OpenAI": {
    "MaxInputCharacters": 32000
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3001",
      "http://127.0.0.1:3001",
      "http://localhost:8081",
      "http://127.0.0.1:8081"
    ],
    "AllowCredentials": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Model.Validation": "Error",
      "LuckyPennySoftware.AutoMapper.License": "Error"
    }
  }
}
