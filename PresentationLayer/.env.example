# === Database ===
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=SmartNightMarket;Username=postgres;Password=YOUR_DB_PASSWORD

# === Redis ===
Redis__ConnectionString=localhost:6379

# === JWT ===
Jwt__SecretKey=YOUR_JWT_SECRET_KEY_MIN_32_CHARS

# === Google OAuth ===
Google__ClientId=YOUR_GOOGLE_CLIENT_ID
Google__ClientSecret=YOUR_GOOGLE_CLIENT_SECRET

# === Email SMTP ===
Email__SmtpHost=smtp.gmail.com
Email__Port=587
Email__FromName=Smart Night Market
Email__FromAddress=YOUR_EMAIL@gmail.com
Email__Username=YOUR_EMAIL@gmail.com
Email__Password=YOUR_APP_PASSWORD
