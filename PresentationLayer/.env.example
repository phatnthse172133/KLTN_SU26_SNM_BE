# === Database ===
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=YOUR_DATABASE;Username=YOUR_USERNAME;Password=YOUR_PASSWORD

# === Controlled integration/demo seed (off unless explicitly enabled) ===
# Run only against a disposable local database or an approved demo/staging database.
SeedDemoData=false
# Optional. If omitted, seeded demo identities receive random non-loginable passwords.
# When supplied, existing deterministic demo identities are normalized to this
# password so a local database can always execute authenticated E2E checks.
SeedDemoDataPassword=

# === Browser CORS / API docs ===
# Comma-separated browser origins. Native React Native clients do not require CORS.
Cors__AllowedOrigins=http://localhost:3000,http://localhost:3001,http://localhost:8081
Cors__AllowCredentials=true
Swagger__Enabled=false

# === Redis ===
Redis__ConnectionString=localhost:6379

# === JWT ===
Jwt__SecretKey=

# === Google OAuth ===
Google__ClientId=YOUR_GOOGLE_CLIENT_ID

# Customer app page that accepts the reset token (not the backend POST endpoint)
Auth__PasswordResetEndpoint=http://localhost:3000/reset-password

# === Email SMTP ===
Email__SmtpHost=smtp.gmail.com
Email__Port=587
Email__FromName=Smart Night Market
Email__FromAddress=YOUR_EMAIL@gmail.com
Email__Username=YOUR_EMAIL@gmail.com
Email__Password=YOUR_APP_PASSWORD

# === Firebase Cloud Messaging ===
Firebase__Enabled=false
Firebase__ProjectId=YOUR_FIREBASE_PROJECT_ID
Firebase__CredentialsPath=PATH_TO_SERVICE_ACCOUNT_JSON

# === Image Storage ===
# Use Local for local filesystem storage, or Cloudinary for managed cloud uploads.
ImageStorage__Provider=Local
Cloudinary__CloudName=YOUR_CLOUDINARY_CLOUD_NAME
Cloudinary__ApiKey=YOUR_CLOUDINARY_API_KEY
Cloudinary__ApiSecret=YOUR_CLOUDINARY_API_SECRET
Cloudinary__RootFolder=smart-night-market

# === Customer AI (Gemini) ===
AIProvider__EnableExternalProvider=false
AIProvider__ApiKey=YOUR_GEMINI_API_KEY
AIProvider__CandidateLimit=200
AIProvider__MaxPreferenceTags=20
AIProvider__MaxQueryLength=500
AIProvider__MaxBudget=100000000
AIProvider__TimeoutSeconds=8
AIProvider__MaxOutputTokens=256
AIProvider__HistoryOrderLimit=30
AIProvider__HistoryReviewLimit=30

# === PayOS Payment Gateway ===
PayOS__ClientId=YOUR_PAYOS_CLIENT_ID
PayOS__ApiKey=YOUR_PAYOS_API_KEY
PayOS__ChecksumKey=YOUR_PAYOS_CHECKSUM_KEY
# Customer native development callbacks. Override with public HTTPS universal
# links when deploying; never use backend localhost for a physical phone.
PayOS__ReturnUrl=snmcustomer://payment/success
PayOS__CancelUrl=snmcustomer://payment/cancel

# Optional: only required when automated PayOS payouts/refunds are enabled.
PayOS__PayOut__ClientId=
PayOS__PayOut__ApiKey=
PayOS__PayOut__ChecksumKey=
