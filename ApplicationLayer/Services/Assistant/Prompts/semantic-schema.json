{
  "type": "object",
  "additionalProperties": false,
  "required": ["scores"],
  "properties": {
    "scores": {
      "type": "array",
      "description": "Exactly one entry per supplied candidate; length must equal candidate count.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["foodItemId", "semanticCompatibility"],
        "properties": {
          "foodItemId": { "type": "string", "format": "uuid" },
          "semanticCompatibility": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reasons": { "type": "array", "maxItems": 1, "items": { "type": "string", "maxLength": 40 } },
          "unknownDataFacets": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
